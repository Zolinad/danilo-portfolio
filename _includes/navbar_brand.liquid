{% if page.permalink != '/' %}
  <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
    {% if site.title == 'blank' %}
      {% if site.first_name %}
        <span class="font-weight-bold">{{ site.first_name }}</span>
      {% endif %}
      {% if site.middle_name %}
        {{- site.middle_name -}}
      {% endif %}
      {% if site.last_name %}
        {{- site.last_name -}}
      {% endif %}
    {% else %}
      <span class="font-weight-bold">{{- site.first_name -}}</span>
      <i class="fa-solid fa-home ml-1"></i>
    {% endif %}
  </a>
{% elsif site.enable_navbar_social %}
  <!-- Social Icons -->
  <div class="navbar-brand social">{% social_links %}</div>
{% endif %}
