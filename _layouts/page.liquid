---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% assign previous_project = nil %}
{% assign next_project = nil %}
{% if page.url contains '/projects/' %}
  {% assign ordered_projects = site.projects | sort: 'date' %}
  {% for project_item in ordered_projects %}
    {% if project_item.url == page.url %}
      {% assign previous_project_index = forloop.index0 | minus: 1 %}
      {% assign next_project_index = forloop.index0 | plus: 1 %}
      {% if previous_project_index >= 0 %}
        {% assign previous_project = ordered_projects[previous_project_index] %}
      {% endif %}
      {% if next_project_index < ordered_projects.size %}
        {% assign next_project = ordered_projects[next_project_index] %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.date %}
      {% assign year = page.date | date: '%Y' %}
      {% assign tags = page.tags | join: '' %}
      {% assign categories = page.categories | join: '' %}

      <p class="post-meta">
        Created on {{ page.date | date: '%B %d, %Y' }}
        {% assign words = content | number_of_words %}
        {% assign read_time = words | divided_by: 180 | at_least: 1 %}
        &nbsp; &middot; &nbsp; <i class="fa-regular fa-clock fa-sm"></i> {{ read_time }} min read
      </p>

      <p class="post-tags">
        <i class="fa-solid fa-calendar fa-sm"></i> {{ year }}
        {% if tags != '' %}
          &nbsp; &middot; &nbsp;
          {% for tag in page.tags %}
            <a href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}"> <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}</a>
            {% unless forloop.last %}
              &nbsp;
            {% endunless %}
          {% endfor %}
        {% endif %}

        {% if categories != '' %}
          &nbsp; &middot; &nbsp;
          {% for category in page.categories %}
            {% if category == "projects" %}
              <a href="{{ '/projects/' | relative_url }}"> <i class="fa-solid fa-tag fa-sm"></i> {{ category -}}</a>
            {% else %}
              <a href="{{ category | slugify | prepend: '/blog/category/' | relative_url }}"> <i class="fa-solid fa-tag fa-sm"></i> {{ category -}}</a>
            {% endif %}
            {% unless forloop.last %}
              &nbsp;
            {% endunless %}
          {% endfor %}
        {% endif %}
      </p>
    {% else %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article{% if page.url contains '/projects/' %} class="post-content"{% endif %}>
    {{ content }}
    <div class="content-share mt-5 text-left">
      <p class="small text-muted mb-1">Enjoyed this page? Share it:</p>
      {% include share.liquid %}
    </div>
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if page.url contains '/projects/' %}
    {% if previous_project or next_project %}
      <nav class="post-sequence-nav" aria-label="Project navigation">
        {% if previous_project %}
          <a class="post-sequence-link post-sequence-link-previous" href="{{ previous_project.url | relative_url }}">
            <span class="post-sequence-symbol" aria-hidden="true"><</span>
            <span>Previous</span>
          </a>
        {% endif %}
        {% if previous_project and next_project %}
          <span class="post-sequence-divider" aria-hidden="true">|</span>
        {% endif %}
        {% if next_project %}
          <a class="post-sequence-link post-sequence-link-next" href="{{ next_project.url | relative_url }}">
            <span>Next</span>
            <span class="post-sequence-symbol" aria-hidden="true">></span>
          </a>
        {% endif %}
      </nav>
    {% endif %}
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
