---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.date %}
      {% assign year = page.date | date: '%Y' %}
      {% assign tags = page.tags | join: '' %}
      {% assign categories = page.categories | join: '' %}

      <p class="post-meta">
        Created on {{ page.date | date: '%B %d, %Y' }}
        {% assign words = content | number_of_words %}
        {% assign read_time = words | divided_by: 180 | at_least: 1 %}
        &nbsp; &middot; &nbsp; <i class="fa-regular fa-clock fa-sm"></i> {{ read_time }} min read
      </p>

      <p class="post-tags">
        <i class="fa-solid fa-calendar fa-sm"></i> {{ year }}
        {% if tags != '' %}
          &nbsp; &middot; &nbsp;
          {% for tag in page.tags %}
            <a href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}"> <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}</a>
            {% unless forloop.last %}
              &nbsp;
            {% endunless %}
          {% endfor %}
        {% endif %}

        {% if categories != '' %}
          &nbsp; &middot; &nbsp;
          {% for category in page.categories %}
            {% if category == "projects" %}
              <a href="{{ '/projects/' | relative_url }}"> <i class="fa-solid fa-tag fa-sm"></i> {{ category -}}</a>
            {% else %}
              <a href="{{ category | slugify | prepend: '/blog/category/' | relative_url }}"> <i class="fa-solid fa-tag fa-sm"></i> {{ category -}}</a>
            {% endif %}
            {% unless forloop.last %}
              &nbsp;
            {% endunless %}
          {% endfor %}
        {% endif %}
      </p>
    {% else %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article{% if page.url contains '/projects/' %} class="post-content"{% endif %}>
    {{ content }}
    <div class="content-share mt-5 text-right">
      <p class="small text-muted mb-1">Gostou? Compartilhe este conteúdo:</p>
      {% include share.liquid %}
    </div>
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
